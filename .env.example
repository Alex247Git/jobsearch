# JobSearch Platform — Environment variables
# Copy to .env and fill in real values. Never commit the real .env.
# The Docker stack works out-of-the-box WITHOUT a .env (dev defaults).

# =========================================================
# DOCKER COMPOSE (docker-compose.yml)
# =========================================================
# Secret that signs JWTs. In production set a long random string
# (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-secret-change-me

# MySQL root credentials + database name
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=jobsearch

# Backend host port + CORS origin allowed by the API
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Optional host-port overrides
# WEB_PORT=3000
# MYSQL_PORT=3306              # MySQL binds to 127.0.0.1 only

# =========================================================
# PRODUCTION OVERLAY (docker-compose.prod.yml)
# Required in production — the stack refuses to start without them
# =========================================================
# Public domain for the Let's Encrypt certificate (NO scheme!):
# DOMAIN=

# =========================================================
# STANDALONE BACKEND (npm start / npm run dev, no Docker)
# =========================================================
# DB_HOST=localhost
# DB_USER=your_mysql_user
# DB_PASSWORD=your_mysql_password
# DB_NAME=your_database_name

# =========================================================
# FRONTEND local dev (Vite): base URL of the backend
# =========================================================
# VITE_API_URL=http://localhost:5000
