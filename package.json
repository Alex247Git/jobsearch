{
  "name": "jobsearch-platform",
  "version": "1.0.0",
  "description": "Full-stack job marketplace with AI-powered matching, real-time chat, and production-grade security.",
  "scripts": {
    "dev": "docker compose up --build",
    "start": "docker compose up",
    "build": "npm run build:frontend",
    "build:frontend": "cd FrontEnd && npm run build",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "jest BackEnd/server.test.js",
    "test:frontend": "cd FrontEnd && npm test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "bcrypt": "^5.1.1",
    "compromise": "^14.14.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "jest": "^29.7.0",
    "supertest": "^6.1.6"
  }
}